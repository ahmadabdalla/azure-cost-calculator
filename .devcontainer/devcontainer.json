{
    "name": "Azure Cost Calculator",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/devcontainers/features/powershell:1": {}
    },
    "postCreateCommand": "npm install -g bats@1.11.1 && pwsh -Command 'Install-Module -Name Pester -MinimumVersion 5.7.1 -Force -Scope CurrentUser; Install-Module -Name PSScriptAnalyzer -RequiredVersion 1.24.0 -Force -Scope CurrentUser'",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "timonwong.shellcheck",
                "foxundermoon.shell-format"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "remoteUser": "ubuntu"
}